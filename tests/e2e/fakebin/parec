#!/usr/bin/env python3
# fake parec: writes s16le mono 16k: a 1 kHz + 200 Hz tone, quiet
import sys, math, time, struct, os
rate = 16000
t = 0
while True:
    n = 320
    buf = b''.join(struct.pack('<h', int(9000*math.sin(2*math.pi*1000*(t+i)/rate) + 9000*math.sin(2*math.pi*200*(t+i)/rate))) for i in range(n))
    t += n
    try:
        sys.stdout.buffer.write(buf); sys.stdout.buffer.flush()
    except BrokenPipeError:
        break
    time.sleep(n/rate)
