#!/bin/bash
# fake yt-dlp: writes a rolling auto-caption style VTT
out=""; while [ $# -gt 0 ]; do [ "$1" = "-o" ] && out="$2"; shift; done
dir=$(dirname "$out"); id=abcdefghijk
cat > "$dir/$id.en.vtt" <<'VTT'
WEBVTT
Kind: captions
Language: en

00:00:01.000 --> 00:00:03.000 align:start position:0%
hello <00:00:01.500><c>everyone</c>

00:00:03.000 --> 00:00:03.010 align:start position:0%
hello everyone

00:00:03.010 --> 00:00:05.000 align:start position:0%
hello everyone
this is <00:00:04.000><c>a caption</c> &amp; more

00:00:05.000 --> 00:00:05.010 align:start position:0%
this is a caption & more

00:00:07.000 --> 00:00:09.000
after a pause
VTT
echo called >> "$dir/ytdlp.calls"
